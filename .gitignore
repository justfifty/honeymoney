# ─── Static site snapshot (generated by scripts/build-static-site.mjs) ────────
deploy/pages/dist/
.wrangler/

# Cloudflare DNS API token for deploy/point-apex-at-pages.mjs. Scoped to
# Zone:DNS:Edit on honeymoney.app only, and deleted after use — but it is still
# a credential and must never be committed.
deploy/.cf-dns.token

# PocketBase settings-encryption key. Without it the S3 credentials configured
# for backups sit in plaintext inside data.db — which is the file being uploaded
# to R2, so an unencrypted backup carries the keys to its own bucket.
#
# LOSING THIS LOSES THE SETTINGS (SMTP, S3), though not the ledger itself. Keep a
# copy somewhere that is NOT a HoneyMoney backup — a password manager.
deploy/.pb-encryption-key

# R2 API credentials used by deploy/setup-r2-backups.mjs to configure PocketBase.
# Scoped to the backups bucket, but still a credential.
deploy/.r2-credentials.json

# SSH keypair used to deploy to DOM Cloud (deploy/domcloud/README.md). The
# PUBLIC half is meant to be pasted into the DOM Cloud dashboard; the private
# half is the only credential this machine holds for the host, so it never
# goes near the repo.
deploy/domcloud/id_domcloud
deploy/domcloud/id_domcloud.pub
deploy/domcloud/.host
