# ─── Captured receipts (personal financial data — never publish) ─────────────
receipts/

# ─── Competition deck PDF exports (local/submission only — not in git) ────────
docs/deck/*.pdf

# ─── Static site snapshot (generated by scripts/build-static-site.mjs) ────────
deploy/pages/dist/
.wrangler/

# Cloudflare DNS API token for deploy/point-apex-at-pages.mjs. Scoped to
# Zone:DNS:Edit on honeymoney.app only, and deleted after use — but it is still
# a credential and must never be committed.
deploy/.cf-dns.token

# PocketBase settings-encryption key. Without it the S3 credentials configured
# for backups sit in plaintext inside data.db — which is the file being uploaded
# to R2, so an unencrypted backup carries the keys to its own bucket.
#
# LOSING THIS LOSES THE SETTINGS (SMTP, S3), though not the ledger itself. Keep a
# copy somewhere that is NOT a HoneyMoney backup — a password manager.
deploy/.pb-encryption-key

# R2 API credentials used by deploy/setup-r2-backups.mjs to configure PocketBase.
# Scoped to the backups bucket, but still a credential.
deploy/.r2-credentials.json

# SSH keypair used to deploy to DOM Cloud (deploy/domcloud/README.md). Only the
# PRIVATE half is withheld — it is the sole credential this machine holds for
# the host. The .pub is tracked on purpose: pb.deploy.yml embeds it to install
# itself into authorized_keys, so hiding the file while publishing its contents
# would only mislead whoever reads one and not the other.
deploy/domcloud/id_domcloud
deploy/domcloud/.host
deploy/domcloud/.pbhost

# Working frames for scripts/build-demo-video.mjs. Regenerated from the live
# site on every run; the MP4 in docs/deck is the artefact worth keeping.
.demo-video/

# Voice auditions from scripts/build-demo-video.mjs --samples. Disposable, and
# kept OUT of .demo-video so a capture run cannot delete them.
.vo-samples/

# Backup encryption key — losing this makes every R2 backup unreadable.
# Keep an offline copy; never commit it.
deploy/.pb-backup-key
deploy/.r2-credentials.json
restored/

# Staged by web/scripts/stage-ocr-assets.mjs — 28 MB of OCR engine + language
# models. Regenerate with `npm run ocr:assets`, never commit.
web/public/ocr/

# Superseded deck and submission material. Kept on disk, out of the repo.
# 79 MB of PDFs, .docx and an mp4 whose only difference from the live ones is a
# date in the filename -- history already records every version that shipped, so
# carrying them in the tree costs every clone and proves nothing.
docs/deck/Archived/
