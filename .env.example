# ─────────────────────────────────────────────────────────────────────────────
# HoneyMoney — Environment Variables
# Copy this file to web/.env.local and fill in your values. NEVER commit secrets.
# See PLAN.md §8 for where to obtain each value.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (database + auth) ───────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only. Bypasses RLS in API routes — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Google Gemini (multimodal OCR + text) ────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.0-flash

# ── Telegram bot (zero-integration ingestion) ────────────────────────────────
# Create with @BotFather; pick any random string for the webhook secret.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=YOUR_RANDOM_SECRET

# ── Demo ─────────────────────────────────────────────────────────────────────
# Printed by supabase/seed.sql — the household shown on /dashboard.
DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111
