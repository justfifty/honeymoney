# ─────────────────────────────────────────────────────────────────────────────
# HoneyMoney — Environment Variables
# Copy this file to web/.env.local . NEVER commit secrets.
# Local-first mode (PocketBase) works with these defaults out of the box.
# See PLAN.md §8 for details.
# ─────────────────────────────────────────────────────────────────────────────

# ── PocketBase (default local database — free, stored on your machine) ──────
# Start it with: npm run pb:start   (admin UI at http://127.0.0.1:8090/_/)
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@honeymoney.local
POCKETBASE_ADMIN_PASSWORD=honeymoney-local-dev

# ── Demo tenants (created automatically by pb_migrations seed) ──────────────
# Household: hhrahman1111111   ·   Business: bizsedap2222222
DEMO_TENANT_ID=hhrahman1111111

# ── AI (all optional) — pick ONE provider. See docs/AI_SETUP.md ─────────────
# The app is fully usable with NO key at all: voice and receipt scanning then
# run on-device (browser Speech API + tesseract.js), costing zero tokens.
# Adding a key upgrades capture to an agentic reader that also gets the
# currency, the date, a confidence score, a suggested bucket, and duplicate /
# subscription / anomaly detection grounded in your own graph.
AI_PROVIDER=gemini          # gemini | groq | ollama

# Google Gemini — https://aistudio.google.com/apikey (free tier, no card).
# The easiest multimodal option: one key covers both text and receipt vision.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq — https://console.groq.com/keys (free tier, no card). Fastest text.
# Vision needs a separate multimodal model id.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Ollama — https://ollama.com/download. Fully local: no key, no cloud, no cost.
# `ollama pull llama3.2 && ollama pull llama3.2-vision`
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision

# ── Exchange rates ─────────────────────────────────────────────────────────
# No configuration needed. Rates are fetched live from Bank Negara Malaysia
# (the central bank's own Open API), falling back to the ECB, then to the last
# rate cached locally, then to an indicative table that is always labelled as
# such. Every figure shows which of those it came from. See /api/fx.

# ── Telegram bot (zero-integration ingestion) — optional ────────────────────
# Create with @BotFather; pick any random string for the webhook secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Supabase (optional cloud-scale path — PLAN.md §6; not needed locally) ───
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
